{
  "name": "lekh",
  "private": true,
  "version": "1.8.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "og": "node scripts/render-og.mjs",
    "icons": "node scripts/render-shortcut-icons.mjs",
    "app-icons": "node scripts/render-app-icons.mjs",
    "check:cheatsheet": "vite build --ssr scripts/check-cheatsheet.ts --outDir .cheatcheck --logLevel error && node .cheatcheck/check-cheatsheet.js && rm -rf .cheatcheck",
    "calendar:data": "node scripts/fetch-calendar-data.mjs",
    "android:assets": "node scripts/export-android-assets.mjs",
    "assetlinks": "node scripts/gen-assetlinks.mjs",
    "android:release": "npm run android:assets && cd android && ./gradlew assembleRelease",
    "play:feature": "node scripts/render-feature-graphic.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "docx": "^9.7.1",
    "mammoth": "^1.12.0",
    "nepali-date-converter": "^3.4.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "license": "MIT"
}
