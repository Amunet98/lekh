<?xml version="1.0" encoding="utf-8"?>
<!-- Where FileProvider is allowed to serve files from. The only consumer is
     androidbrowserhelper's splash-screen handoff: it writes the splash
     bitmap into this subdirectory and hands Chrome a content:// URI to it,
     so Chrome can paint the same splash as an overlay while it verifies the
     site and loads the page — the moment that otherwise briefly shows
     Chrome's own Custom Tab toolbar (address bar, share, ⋮) before the app
     goes full-screen.

     files-path, not cache-path: SplashImageTransferTask writes to
     context.getFilesDir()/twa_splash/, not the cache dir. Getting this wrong
     crashed every launch — FileProvider.getUriForFile() throws
     IllegalArgumentException when the file it's asked to serve isn't under
     any configured root, and a cache-path root never matches a files-dir
     path. Confirmed via adb logcat: "Failed to find configured root that
     contains .../files/twa_splash/splash_image.png". -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="twa_splash" path="twa_splash/" />
</paths>
