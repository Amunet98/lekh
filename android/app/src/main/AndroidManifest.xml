<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Trusted Web Activity opens Lekh in the user's own Chrome, so the
         app needs network access. The WIDGET still reads bundled assets only
         and makes no requests of its own — see Panchang.kt. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="false">

        <!-- One install, two things: this activity is the app, the receiver
             below is the home-screen widget. Splitting them into two downloads
             was the alternative, and nobody installs two. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:label="@string/app_name">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="${twaUrl}" />

            <!-- Matches the PWA's own theme-color and background, so the
                 splash the launcher draws does not flash a different colour
                 than the page that follows it. -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/twa_status_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@mipmap/ic_launcher" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/twa_background" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets the app open lekh links directly. android:autoVerify ties
                 it to the same assetlinks.json that removes Chrome's address
                 bar, so both are verified by one file. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${twaHost}" />
            </intent-filter>
        </activity>

        <!-- Chrome needs this to know which app owns the TWA session. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- exported="true" is required, not a slip. A widget provider is a
             broadcast receiver that the *system* sends APPWIDGET_UPDATE to;
             exported="false" means those broadcasts never arrive and the
             widget silently never draws. Android 12+ also requires the
             attribute to be stated explicitly whenever there is an
             intent-filter. -->
        <receiver
            android:name=".widget.LekhWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <!-- Redraw when the date moves underneath us. -->
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
