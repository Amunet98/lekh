<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+; minSdk is 26, so this is every phone).
     Foreground and monochrome are GENERATED by design/logo/build_mark.py.
     Monochrome is what Android 13+ tints for themed icons — without it the
     icon stays in its own colours among the themed ones. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
