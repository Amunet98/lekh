<?xml version="1.0" encoding="utf-8"?>
<!-- The marker behind today's cell in the 5x2 week strip. Applied at draw
     time, not in the layout, because which of the seven cells is today
     changes daily: WidgetRenderer sets it with
     setInt(id, "setBackgroundResource", …) and clears the other six with 0. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_today" />
    <corners android:radius="10dp" />
</shape>
