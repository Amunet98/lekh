<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar leaf's page: the box the date sits in, under the crimson
     strip (widget_leaf_head.xml). The 1dp edge is what separates a white page
     from a white card in light mode; the strip covers it along the top. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_leaf" />
    <stroke android:width="1dp" android:color="@color/widget_border" />
    <corners android:radius="10dp" />
</shape>
