<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar leaf's page: the box the date sits in, under the crimson
     strip (widget_leaf_head.xml). Borderless since 1.9.114 (owner's call):
     the page is a faint layer on the card, and the strip
     along its top is what makes it read as a leaf. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/widget_leaf" />
    <corners android:radius="10dp" />
</shape>
