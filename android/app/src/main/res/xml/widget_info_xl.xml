<?xml version="1.0" encoding="utf-8"?>
<!-- 5x1. minWidth is 5*70-30=320dp by the platform's cell formula.

     A four-column launcher does not hide this — measured on one, it lists it
     and clamps it to four cells wide. targetCellWidth is a request, minWidth
     is the floor, and the layout is weighted so it degrades to the 4x1's
     proportions rather than clipping.

     resizeMode includes vertical: dragged taller, the provider swaps in
     widget_patro_xl_expanded (see BaseLekhWidgetProvider's EXPANDING ON
     RESIZE) rather than just centering this row in more space. -->
<!-- Both flags are API 31+. reconfigurable puts "Widget settings" on the
     launcher's long-press menu, which opens LekhWidgetConfigActivity (the
     widget's language); configuration_optional skips that screen on
     placement, since Nepali is a fine default. Below API 31 neither exists
     and the screen opens once, on placement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="40dp"
    android:targetCellWidth="5"
    android:targetCellHeight="1"
    android:description="@string/widget_description_xl"
    android:previewLayout="@layout/widget_patro_xl"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_patro_xl"
    android:updatePeriodMillis="0" />
