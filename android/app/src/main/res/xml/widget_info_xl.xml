<?xml version="1.0" encoding="utf-8"?>
<!-- 5x1. minWidth is 5*70-30=320dp by the platform's cell formula.

     A four-column launcher does not hide this — measured on one, it lists it
     and clamps it to four cells wide. targetCellWidth is a request, minWidth
     is the floor, and the layout is weighted so it degrades to the 4x1's
     proportions rather than clipping. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="40dp"
    android:targetCellWidth="5"
    android:targetCellHeight="1"
    android:description="@string/widget_description_xl"
    android:previewLayout="@layout/widget_patro_xl"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/widget_patro_xl"
    android:updatePeriodMillis="0" />
