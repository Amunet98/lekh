<?xml version="1.0" encoding="utf-8"?>
<!-- The month widget (1.9.114): five cells wide, four tall where the grid
     allows. minHeight 250dp is a header, weekday row, six rows of dates and
     the footer at a size the dates stay readable; a four-column launcher
     clamps the width rather than hiding it, as it does the 5x1.

     The picker preview is layout/widget_preview_month, generated by
     scripts/render-widget-previews.mjs with the day cells written out (the
     real layout adds them at draw time, so it is an empty grid). A layout
     rather than a picture so it takes the wallpaper's colours like the other
     four sizes' previews; the PNG it replaced carried the test phone's brown
     to every phone (2.0.0). No previewImage: below Android 12 no size has a
     preview, and the picker shows the app icon for all five alike. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="200dp"
    android:targetCellWidth="5"
    android:targetCellHeight="4"
    android:description="@string/widget_description_month"
    android:previewLayout="@layout/widget_preview_month"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_patro_month"
    android:updatePeriodMillis="0" />
