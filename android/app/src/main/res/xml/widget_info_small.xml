<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1. minWidth/minHeight are the pre-Android-12 sizing, kept because
     minSdk is 26; targetCellWidth/Height are what Android 12+ actually uses. -->
<!-- configuration_optional keeps the settings screen out of the way when a
     widget is placed (it uses whatever script is already set) while
     reconfigurable puts it behind a long-press on the placed widget.
     Both are API 31+; below that the configure activity simply opens on
     placement, which is the only behaviour those versions have. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:description="@string/widget_description_small"
    android:previewLayout="@layout/widget_patro_small"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="configuration_optional|reconfigurable"
    android:initialLayout="@layout/widget_patro_small"
    android:updatePeriodMillis="0" />
