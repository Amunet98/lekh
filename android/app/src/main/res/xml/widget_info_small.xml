<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1. minWidth/minHeight are the pre-Android-12 sizing, kept because
     minSdk is 26; targetCellWidth/Height are what Android 12+ actually uses. -->
<!-- configuration_optional is API 31+: it skips the configure activity on
     placement since there is nothing left for it to ask (no reconfigurable —
     there is nothing to reconfigure either). Below API 31 the activity opens
     on placement regardless and just confirms immediately. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:description="@string/widget_description_small"
    android:previewLayout="@layout/widget_patro_small"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="configuration_optional"
    android:initialLayout="@layout/widget_patro_small"
    android:updatePeriodMillis="0" />
