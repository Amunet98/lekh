<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1. minWidth/minHeight are the pre-Android-12 sizing, kept because
     minSdk is 26; targetCellWidth/Height are what Android 12+ actually uses. -->
<!-- Both flags are API 31+. reconfigurable puts "Widget settings" on the
     launcher's long-press menu, which opens LekhWidgetConfigActivity (the
     widget's language); configuration_optional skips that screen on
     placement, since Nepali is a fine default. Below API 31 neither exists
     and the screen opens once, on placement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:description="@string/widget_description_small"
    android:previewLayout="@layout/widget_patro_small"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_patro_small"
    android:updatePeriodMillis="0" />
