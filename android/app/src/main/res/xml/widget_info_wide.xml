<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1. resizeMode includes vertical, but there is no expanded layout:
     dragged taller, the row just centers in more space (see
     LekhWidgetWideProvider). The week is the 5x1's. -->
<!-- Both flags are API 31+. reconfigurable puts "Widget settings" on the
     launcher's long-press menu, which opens LekhWidgetConfigActivity (the
     widget's language); configuration_optional skips that screen on
     placement, since Nepali is a fine default. Below API 31 neither exists
     and the screen opens once, on placement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:description="@string/widget_description_wide"
    android:previewLayout="@layout/widget_patro_wide"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_patro_wide"
    android:updatePeriodMillis="0" />
