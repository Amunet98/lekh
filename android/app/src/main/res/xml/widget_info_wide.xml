<?xml version="1.0" encoding="utf-8"?>
<!-- 4x1. resizeMode includes vertical: dragged taller, the provider swaps in
     widget_patro_wide_expanded (see BaseLekhWidgetProvider's EXPANDING ON
     RESIZE) rather than just centering this row in more space. -->
<!-- configuration_optional is API 31+: it skips the configure activity on
     placement since there is nothing left for it to ask (no reconfigurable —
     there is nothing to reconfigure either). Below API 31 the activity opens
     on placement regardless and just confirms immediately. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:description="@string/widget_description_wide"
    android:previewLayout="@layout/widget_patro_wide"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="configuration_optional"
    android:initialLayout="@layout/widget_patro_wide"
    android:updatePeriodMillis="0" />
