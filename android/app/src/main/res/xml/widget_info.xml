<?xml version="1.0" encoding="utf-8"?>
<!-- Both flags are API 31+. reconfigurable puts "Widget settings" on the
     launcher's long-press menu, which opens LekhWidgetConfigActivity (the
     widget's language); configuration_optional skips that screen on
     placement, since Nepali is a fine default. Below API 31 neither exists
     and the screen opens once, on placement. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:description="@string/widget_description"
    android:previewLayout="@layout/widget_patro"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="np.com.bimeshpoudel.lekh.widget.LekhWidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:initialLayout="@layout/widget_patro"
    android:updatePeriodMillis="0" />
