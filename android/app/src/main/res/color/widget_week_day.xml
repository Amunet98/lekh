<?xml version="1.0" encoding="utf-8"?>
<!-- A date in the 5x2 week strip: accent on a day off, normal otherwise.
     Same reasoning as res/color/widget_day.xml — the launcher resolves it, we
     only set the state.

     Driven by state_enabled, which reads oddly and is deliberate. The state has
     to be one RemoteViews can actually set, and the allowlist is short:
     setSelected and setActivated are NOT remotable — setSelected throws
     "TextView can't use method with RemoteViews", which surfaces on a home
     screen as "Can't load widget" — while setEnabled is. Nothing here is
     interactive, so "disabled" carries no meaning to lose: the widget's only
     click target is the root, and these TextViews are never focusable.
 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/widget_accent" />
    <item android:color="@color/widget_text" />
</selector>
