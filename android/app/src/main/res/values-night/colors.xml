<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme. Widget accent is #F87171 rather than the flag crimson for
     the same reason as the web app: #C8102E on a blue-black surface is
     1.6:1. launch_background has no light key here on purpose — this file
     only overrides what actually differs at night. -->
<resources>
    <color name="launch_background">#0E1220</color>

    <!-- Translucent, not opaque: see the comment on widget_background.xml for why. -->
    <color name="widget_surface">#F0231A17</color>
    <color name="widget_border">#4A3A31</color>
    <color name="widget_text">#F3EAE0</color>
    <color name="widget_muted">#C2B2A2</color>
    <color name="widget_accent">#F28B82</color>
    <!-- Today's cell: lifted surface, not a red wash; a crimson tint on #151A2B reads as an error state. -->
    <color name="widget_today">#4A3830</color>
    <!-- Night twins of the fixed widget colours — see values/colors.xml. -->
    <color name="widget_static_text">#F3EAE0</color>
    <color name="widget_static_muted">#C2B2A2</color>
    <color name="widget_static_accent">#F28B82</color>
    <color name="widget_static_border">#4A3A31</color>
    <color name="widget_static_today">#4A3830</color>

    <!-- The leaf at night: a lighter crimson so the strip still reads as red
         on the dark card (white on #B8202F is 6.3:1), and the page one step
         up from the card, as the app's second surface is. -->
    <color name="widget_head">#B3261E</color>
    <color name="widget_on_head">#FFFFFF</color>
    <color name="widget_leaf">#2E2320</color>
    <color name="widget_static_head">#B3261E</color>
    <color name="widget_static_on_head">#FFFFFF</color>
    <color name="widget_static_leaf">#2E2320</color>

    <!-- Patro at night (2.0.25): warm ink, not blue-black, so it is the same
         paper with the lights off. Muted 8:1 and #F28B82 7:1 on #231A17. -->
    <color name="widget_chip">#3F3029</color>
    <color name="widget_static_chip">#3F3029</color>
</resources>
