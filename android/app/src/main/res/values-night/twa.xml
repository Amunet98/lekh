<?xml version="1.0" encoding="utf-8"?>
<!-- Only the splash background belongs here.

     The status and navigation bars are NOT overridden in night resources on
     purpose: androidbrowserhelper reads their light and dark values as two
     separate manifest keys in a single pass, so the dark variants live in
     values/twa.xml as their own colours. Redefining the base colours here
     would darken the light colour scheme as well. SPLASH_SCREEN_BACKGROUND_COLOR
     has no such dark key, so this is the only way to keep the launch screen
     from flashing white before a dark page. -->
<resources>
    <color name="twa_background">#0E1220</color>
</resources>
