    <!-- Shown under each entry in the launcher's widget picker. They differ so
         four near-identical rows are actually distinguishable. -->
    <string name="widget_description">Date, tithi and today\'s festival</string>
    <string name="widget_description_small">Just the Bikram Sambat date</string>
    <string name="widget_description_wide">A full-width strip: date and festival</string>
    <string name="widget_description_xl">Wide strip: date, tithi and what\'s next</string>

    <!-- Long-press app shortcuts (res/xml/shortcuts.xml). The web manifest's
         own `shortcuts` (vite.config.ts) only reach the launcher for an
         installed PWA/WebAPK — this app is a plain Capacitor WebView, not
         registered with Chrome's WebAPK system, so the OS never sees those.
         Native static shortcuts are the separate, required mechanism for an
         actual APK; they were never carried over from the old TWA project. -->
    <string name="shortcut_type_short">Type</string>
    <string name="shortcut_type_long">Type Nepali</string>
    <string name="shortcut_translate_short">Translate</string>
    <string name="shortcut_translate_long">Translate</string>
    <!-- Bare "Patro", matching the in-app tab exactly (TabSwitcher.tsx) —
         same reasoning as shortcut_translate_long staying just "Translate":
         the name is already the identity, a descriptor after it reads like
         a translation gloss rather than the app's own word for the thing. -->
    <string name="shortcut_patro_short">Patro</string>
    <string name="shortcut_patro_long">Patro</string>
</resources>
