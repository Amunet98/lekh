<?xml version="1.0" encoding="utf-8"?>
<!-- Light theme. Widget colors are the web app's Crimson & Paper tokens,
     contrast-checked there — see the table at the top of src/index.css.
     colorPrimary/colorPrimaryDark/colorAccent back AppTheme (styles.xml);
     launch_background is the native-splash color, shown briefly before
     MainActivity's WebView paints — see AppTheme.NoActionBarLaunch. -->
<resources>
    <color name="colorPrimary">#0E1220</color>
    <color name="colorPrimaryDark">#0E1220</color>
    <color name="colorAccent">#A80D26</color>

    <color name="launch_background">#FAFAFB</color>

    <!-- Adaptive launcher icon tile (mipmap-anydpi-v26/ic_launcher.xml). Fixed:
         the icon is the brand, so no night or v31 twin — Material You only
         reaches it through the monochrome layer, as a themed icon. -->
    <color name="ic_launcher_background">#151A2B</color>

    <!-- Translucent, not opaque: see the comment on widget_background.xml for why. -->
    <color name="widget_surface">#E6FFFFFF</color>
    <color name="widget_border">#DDE1E9</color>
    <color name="widget_text">#141824</color>
    <color name="widget_muted">#646C7E</color>
    <color name="widget_accent">#A80D26</color>
    <!-- Today's cell in the week strip: the web app's pale accent wash. -->
    <color name="widget_today">#FBE9EC</color>
    <!-- The same Crimson & Paper widget colours under names values-v31/ does NOT
         override, so they stay fixed when Material You is on. WidgetTheme.kt
         swaps a widget onto these when the app's "Wallpaper colours" setting is
         off. widget_surface needs no twin: values-v31/ never overrides it. -->
    <color name="widget_static_text">#141824</color>
    <color name="widget_static_muted">#646C7E</color>
    <color name="widget_static_accent">#A80D26</color>
    <color name="widget_static_border">#DDE1E9</color>
    <color name="widget_static_today">#FBE9EC</color>
</resources>
