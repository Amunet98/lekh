<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2. Here the whole card is the calendar leaf: a strip across the top
     carrying the weekday (widget_leaf_head, on the card-wide widget_band),
     then the date large, the month, the moon and tithi, and the festival line.

     A widget is drawn through RemoteViews, which supports only a fixed set of
     views and cannot load a custom font, so the Devanagari renders in
     whatever the device provides for the script.

     The android:text values are placeholders: they are what the launcher's
     widget picker previews before the first render, so they show a real date
     rather than "TextView". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_leaf_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="5dp"
        android:paddingHorizontal="8dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_head"
        android:background="@drawable/widget_band"
        android:text="मङ्गलबार" />

    <!-- widget_body: WidgetRenderer.fitSquare trims its bottom padding when
         the widget is placed shorter than this layout's natural height. -->
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_day"
            android:text="१७" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="कार्तिक २०८३" />

        <!-- The moon at today's phase and the tithi (design A, 1.9.114). The AD
             date is not shown at this size any more; widget_ad stays below,
             hidden, so the one renderer can still write to it. -->
        <LinearLayout
            android:id="@+id/widget_tithi_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_moon"
                android:src="@drawable/widget_moon_preview"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_tithi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="नवमी" />
        </LinearLayout>

        <!-- The festival line: today's festival, else the next one and how far
             off it is. maxLines=2 with ellipsize because festival names run
             long and a widget cannot scroll. -->
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/widget_accent"
            android:text="रमा एकादशी · २ दिनमा" />
    </LinearLayout>

    <!-- Present so one renderer can populate every layout. The weekday is in
         the strip here, and the AD date has no room since 1.9.114. -->
    <TextView android:id="@+id/widget_weekday"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_ad"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_next"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
</LinearLayout>
</FrameLayout>
