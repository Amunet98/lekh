<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2. Here the whole card is the calendar leaf: a strip across the top
     carrying the weekday (widget_leaf_head, on the card-wide widget_band),
     then the date large, the month, the AD date and the festival line.

     A widget is drawn through RemoteViews, which supports only a fixed set of
     views and cannot load a custom font, so the Devanagari renders in
     whatever the device provides for the script.

     The android:text values are placeholders: they are what the launcher's
     widget picker previews before the first render, so they show a real date
     rather than "TextView". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_leaf_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="5dp"
        android:paddingHorizontal="8dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_on_head"
        android:background="@drawable/widget_band"
        android:text="आइतबार" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="40sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_day"
            android:text="२५" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="असोज २०८३" />

        <TextView
            android:id="@+id/widget_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="11 Oct 2026" />

        <!-- The festival line. maxLines=2 with ellipsize because festival
             names run long and a widget cannot scroll. -->
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/widget_accent"
            android:text="घटस्थापना" />
    </LinearLayout>

    <!-- Present so one renderer can populate every layout. The weekday is in
         the strip here; tithi falls back into the festival line. -->
    <TextView android:id="@+id/widget_weekday"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_tithi"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_next"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
</LinearLayout>
