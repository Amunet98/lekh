<?xml version="1.0" encoding="utf-8"?>
<!-- 2x1. The calendar leaf (weekday strip over the date) beside the month
     and the AD date. Tithi and the festival line are gone at this size — a
     festival name has nowhere to go here, and a truncated one is worse than
     none.

     The leaf is the widget's signature on every size: a crimson strip over a
     page, the शिरोरेखा of the hanging-page logo. Its strip is
     widget_leaf_head, its page widget_leaf; WidgetTheme swaps both drawables
     for their _static twins when "Wallpaper colours" is off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:id="@+id/widget_leaf"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_leaf">

        <TextView
            android:id="@+id/widget_leaf_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="1dp"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_on_head"
            android:background="@drawable/widget_leaf_head"
            android:text="आइत" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:textSize="21sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_day"
            android:text="२५" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Shrinks to fit rather than ellipsizing. Two cells are only
             ~138dp on some launchers (the A024's Nothing launcher), which
             leaves this column ~60dp, and "कार्तिक २०८३" needs ~78dp at 13sp:
             the year was cut to "कार्तिक २…". Autosize is an XML attribute,
             so it works through RemoteViews, from API 26 (minSdk). It needs
             a fixed height, hence 20dp: one bold 13sp Devanagari line. -->
        <TextView
            android:id="@+id/widget_month"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp"
            android:autoSizeStepGranularity="0.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="असोज २०८३" />

        <TextView
            android:id="@+id/widget_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="11 Oct 2026" />
    </LinearLayout>

    <!-- Present so one renderer can populate every layout; no room at 2x1. -->
    <TextView android:id="@+id/widget_weekday"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_tithi"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_note"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_next"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
</LinearLayout>
