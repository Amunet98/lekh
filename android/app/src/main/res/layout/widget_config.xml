<?xml version="1.0" encoding="utf-8"?>
<!-- Two choices and nothing else. This is a dialog that opens when a widget is
     placed on older Androids, so anything beyond the actual question is a
     speed bump between wanting a widget and having one.

     A RadioGroup rather than two buttons because the current setting has to be
     visible: someone opening this from a placed widget is usually checking
     what it is set to, not changing it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_prompt"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <RadioGroup
        android:id="@+id/config_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/config_nepali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:textSize="17sp"
            android:text="@string/config_nepali" />

        <RadioButton
            android:id="@+id/config_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            android:textSize="17sp"
            android:text="@string/config_english" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/config_note"
        android:textSize="12sp"
        android:alpha="0.7"
        android:layout_marginTop="16dp" />
</LinearLayout>
