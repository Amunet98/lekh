<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2. Two columns: the date carries the left, and the width that the
     smaller sizes do not have goes to the things they have to drop — the
     weekday spelled out, the tithi on its own line, and a festival name with
     room to be read rather than ellipsised. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="16dp">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="44sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:textColor="@color/widget_day"
            android:text="२९" />

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="श्रावण २०८३" />
    </LinearLayout>

    <!-- An ImageView, not a plain <View>, and that is not a style choice.
         RemoteViews inflates only an allowlist of classes; android.view.View
         is not on it, and a layout containing one throws
         "Class not allowed to be inflated" — which on a home screen surfaces
         as "Problem loading widget" with no further explanation. ImageView is
         allowed and draws a background just as well. -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="6dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_weekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="शुक्रबार" />

        <TextView
            android:id="@+id/widget_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:layout_marginTop="1dp"
            android:textColor="@color/widget_muted"
            android:text="14 Aug 2026" />

        <TextView
            android:id="@+id/widget_tithi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="प्रतिपदा" />

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="5dp"
            android:textColor="@color/widget_accent"
            android:text="गुँलाधर्म आरम्भ" />
    </LinearLayout>
    <!-- Present so one renderer can populate every layout; no room at 4x2. -->
    <TextView android:id="@+id/widget_next"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
</LinearLayout>
