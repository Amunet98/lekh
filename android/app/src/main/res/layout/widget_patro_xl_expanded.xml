            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="बुध" />
            <TextView android:id="@+id/widget_week_d3"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="९" />
            <TextView android:id="@+id/widget_week_t3"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="प्रतिपदा" />
            <ImageView android:id="@+id/widget_week_f3"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_week_c4"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="बिही" />
            <TextView android:id="@+id/widget_week_d4"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="१०" />
            <TextView android:id="@+id/widget_week_t4"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="द्वितीया" />
            <ImageView android:id="@+id/widget_week_f4"
                android:layout_width="4dp" android:layout_height="4dp"
