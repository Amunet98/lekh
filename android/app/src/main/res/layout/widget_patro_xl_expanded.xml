                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_week_c5"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="शुक्र" />
            <TextView android:id="@+id/widget_week_d5"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="११" />
            <TextView android:id="@+id/widget_week_t5"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="तृतीया" />
            <ImageView android:id="@+id/widget_week_f5"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_week_c6"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_pill">
            <TextView android:id="@+id/widget_week_l6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="शनि" />
            <TextView android:id="@+id/widget_week_d6"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="१२" />
            <TextView android:id="@+id/widget_week_t6"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="चतुर्थी" />
            <ImageView android:id="@+id/widget_week_f6"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/widget_space2"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="4dp" />

    <LinearLayout
        android:id="@+id/widget_ag_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/widget_row">
        <TextView android:id="@+id/widget_ag_name0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="भैरवाष्टमी" />
        <TextView android:id="@+id/widget_ag_when0"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp" android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="मङ्गल, मंसिर १५" />
        <TextView android:id="@+id/widget_ag_days0"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/widget_count"
            android:textColor="@color/widget_on_head"
            android:text="३ दिन" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_ag_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/widget_row">
        <TextView android:id="@+id/widget_ag_name1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="ल्होसार" />
        <TextView android:id="@+id/widget_ag_when1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp" android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="बिही, मंसिर २४" />
        <TextView android:id="@+id/widget_ag_days1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/widget_count_quiet"
            android:textColor="@color/widget_text"
            android:text="१२ दिन" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_ag_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:background="@drawable/widget_row">
        <TextView android:id="@+id/widget_ag_name2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="13sp" android:textStyle="bold"
            android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="उधौली पर्व" />
        <TextView android:id="@+id/widget_ag_when2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
