<?xml version="1.0" encoding="utf-8"?>
<!-- The tall widget (the 5x1 dragged to two rows or more): design D from
     the owner's canvas (2.0.25). The month and today's date across the top,
     the week with each day's tithi, today a filled tile, and what is coming
     as a short agenda underneath.

     It rearranges rather than scales when the launcher gives it more room,
     as Android's widget quality guide asks: WidgetRenderer.renderTall shows
     one, two or three agenda rows by the placed height (Launcher3's 5x2 is
     ~137dp, One UI's 240dp). The two weighted spacers share out whatever is
     left, so the card is filled edge to edge at any of them.

     The sample text is what the picker and the debug harness show before the
     renderer runs. No plain <View> (RemoteViews cannot inflate one): the
     spacers are FrameLayouts. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

<LinearLayout
    android:id="@+id/widget_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp">
        <TextView
            android:id="@+id/widget_month"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="मंसिर २०८३" />
        <TextView
            android:id="@+id/widget_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="11sp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="शनि १२ · 28 Nov" />
    </LinearLayout>

    <FrameLayout android:id="@+id/widget_space1"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:minHeight="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:id="@+id/widget_week_c0"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="आइत" />
            <TextView android:id="@+id/widget_week_d0"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="६" />
            <TextView android:id="@+id/widget_week_t0"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="त्रयोदशी" />
            <ImageView android:id="@+id/widget_week_f0"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_week_c1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="सोम" />
            <TextView android:id="@+id/widget_week_d1"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="७" />
            <TextView android:id="@+id/widget_week_t1"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="चतुर्दशी" />
            <ImageView android:id="@+id/widget_week_f1"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="visible"
                android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_week_c2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="1.5dp"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="3dp" >
            <TextView android:id="@+id/widget_week_l2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:maxLines="1"
                android:textColor="@color/widget_week_label"
                android:text="मङ्गल" />
            <TextView android:id="@+id/widget_week_d2"
                android:textLocale="ne-NP"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textStyle="bold" android:includeFontPadding="false"
                android:paddingVertical="1dp" android:maxLines="1"
                android:textColor="@color/widget_week_day"
                android:text="८" />
            <TextView android:id="@+id/widget_week_t2"
                android:layout_width="match_parent" android:layout_height="12dp"
                android:gravity="center" android:maxLines="1"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp"
                android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="0.5sp"
                android:textColor="@color/widget_muted"
                android:text="पूर्णिमा" />
            <ImageView android:id="@+id/widget_week_f2"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="visible"
