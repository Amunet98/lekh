<?xml version="1.0" encoding="utf-8"?>
<!-- The 5x1 (xl) widget, resized taller: the compact row's exact horizontal
     arrangement, unchanged, plus a divider and a week strip below it.

     Earlier versions stacked weekday/date/tithi/note/next in a narrow
     vertical column nested inside weighted rows, and on a real placed widget
     (not the debug preview, which renders in-process and never showed the
     bug) the two rows using ellipsize came back blank. The compact row has
     always rendered them on-device, so this reuses it as is and gives the
     extra height to the week strip instead.

     Selected at runtime, not by a separate provider: see
     BaseLekhWidgetProvider.expandedLayoutRes and onAppWidgetOptionsChanged.

     No plain <View>: RemoteViews cannot inflate android.view.View. The
     dividers are ImageViews.
     Each day carries a festival dot (widget_week_fN, 1.9.114), invisible
     rather than gone on a day without one so every column keeps one height. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">


<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/widget_leaf"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_leaf">

        <TextView
            android:id="@+id/widget_leaf_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="1dp"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_on_head"
            android:background="@drawable/widget_leaf_head"
            android:text="मङ्गल" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:textSize="21sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_day"
            android:text="१७" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="कार्तिक २०८३" />

        <!-- The AD date, the moon at today's phase and the tithi (1.9.114, design
             A). The moon is a bitmap drawn by MoonPhase and tinted at draw time. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="3 Nov 2026" />
            <ImageView
                android:id="@+id/widget_moon"
                android:src="@drawable/widget_moon_preview"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/widget_tithi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="नवमी" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_divider1"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="6dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Today's festival, or else the next one (design A, 1.9.114). -->
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"
            android:textColor="@color/widget_accent"
            android:text="रमा एकादशी" />

        <!-- How far off it is, as a pill (design A): "३ दिनमा", or "आज" when
             the festival above is today's. -->
        <TextView
            android:id="@+id/widget_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="1dp"
            android:background="@drawable/widget_chip"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_text"
            android:text="२ दिनमा" />
    </LinearLayout>
    </LinearLayout>

    <!-- Present so one renderer can populate every layout. The weekday is in
         the leaf's strip, and the tithi has its own view beside the AD date. -->
    <TextView android:id="@+id/widget_weekday"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />

    <ImageView
        android:id="@+id/widget_divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_week_c0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="आइत" />
            <TextView android:id="@+id/widget_week_d0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="१५" />
            <ImageView android:id="@+id/widget_week_f0"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="सोम" />
            <TextView android:id="@+id/widget_week_d1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="१६" />
            <ImageView android:id="@+id/widget_week_f1"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="मङ्गल" />
            <TextView android:id="@+id/widget_week_d2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="१७" />
            <ImageView android:id="@+id/widget_week_f2"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="बुध" />
            <TextView android:id="@+id/widget_week_d3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="१८" />
            <ImageView android:id="@+id/widget_week_f3"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="बिही" />
            <TextView android:id="@+id/widget_week_d4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="१९" />
            <ImageView android:id="@+id/widget_week_f4"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c5"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="शुक्र" />
            <TextView android:id="@+id/widget_week_d5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२०" />
            <ImageView android:id="@+id/widget_week_f5"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c6"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="10sp" android:textColor="@color/widget_week_label"
                android:text="शनि" />
            <TextView android:id="@+id/widget_week_d6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२१" />
            <ImageView android:id="@+id/widget_week_f6"
                android:layout_width="4dp" android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/widget_dot"
                android:visibility="invisible"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
