<?xml version="1.0" encoding="utf-8"?>
<!-- The 5x1 (xl) widget, resized taller: the compact row's exact horizontal
     arrangement, unchanged, plus a divider and a week strip below it.

     Earlier versions stacked weekday/date/tithi/note/next in a narrow
     vertical column nested inside weighted rows, and on a real placed widget
     (not the debug preview, which renders in-process and never showed the
     bug) the two rows using ellipsize came back blank. The compact row has
     always rendered them on-device, so this reuses it as is and gives the
     extra height to the week strip instead.

     Selected at runtime, not by a separate provider: see
     BaseLekhWidgetProvider.expandedLayoutRes and onAppWidgetOptionsChanged.

     No plain <View>: RemoteViews cannot inflate android.view.View. The
     dividers are ImageViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/widget_leaf"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/widget_leaf">

        <TextView
            android:id="@+id/widget_leaf_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="1dp"
            android:textSize="9sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_on_head"
            android:background="@drawable/widget_leaf_head"
            android:text="आइत" />

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:textSize="21sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_day"
            android:text="२५" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:text="असोज २०८३" />

        <!-- The AD date, and on this size the tithi after it: WidgetRenderer
             writes "11 Oct 2026 · प्रतिपदा" here, which frees the right-hand
             column for the festival and what comes next. -->
        <TextView
            android:id="@+id/widget_ad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="11 Oct 2026 · प्रतिपदा" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_divider1"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginVertical="6dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Today's festival; hidden (setViewVisibility) on a day with none,
             because the tithi already shows on the left. -->
        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"
            android:textColor="@color/widget_accent"
            android:text="घटस्थापना" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_marginTop="1dp"
            android:textColor="@color/widget_muted"
            android:text="आगामी · फूलपाती · ६ दिनमा" />
    </LinearLayout>
    </LinearLayout>

    <!-- Present so one renderer can populate every layout. The weekday is in
         the leaf's strip, and the tithi rides on the AD line. -->
    <TextView android:id="@+id/widget_weekday"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />
    <TextView android:id="@+id/widget_tithi"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:visibility="gone" android:text="" />

    <ImageView
        android:id="@+id/widget_divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_week_c0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="आइत" />
            <TextView android:id="@+id/widget_week_d0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२५" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="सोम" />
            <TextView android:id="@+id/widget_week_d1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२६" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="मङ्गल" />
            <TextView android:id="@+id/widget_week_d2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२७" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="बुध" />
            <TextView android:id="@+id/widget_week_d3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२८" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="बिहि" />
            <TextView android:id="@+id/widget_week_d4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२९" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c5"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="शुक्र" />
            <TextView android:id="@+id/widget_week_d5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="३०" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c6"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="शनि" />
            <TextView android:id="@+id/widget_week_d6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textStyle="bold" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="३१" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
