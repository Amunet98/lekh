            android:textSize="11sp" android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:text="शनि, पुस ९" />
        <TextView android:id="@+id/widget_ag_days2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingHorizontal="8dp"
            android:textSize="11sp" android:textStyle="bold" android:maxLines="1"
            android:background="@drawable/widget_count_quiet"
            android:textColor="@color/widget_text"
