<?xml version="1.0" encoding="utf-8"?>
<!-- The 5x1 (xl) widget, resized taller. The compact row's exact horizontal
     arrangement, unchanged, plus a divider and a week strip below it.

     Earlier versions of this file stacked weekday/date/tithi/note/next in a
     narrow vertical column nested inside a weight="1" row nested inside a
     weight="1" root — every size-vs-height combination it was actually
     resized to was reproduced, and on a real placed widget (not this file's
     own debug preview, which renders in-process and never showed the bug)
     the two rows using ellipsize (widget_note, widget_next) came back
     blank while every plain maxLines row rendered fine. The compact row
     below uses the exact same ellipsize rows and has always rendered
     correctly on-device, in this app and every version before the resize
     feature existed — so the fix is to stop re-deriving a new column layout
     for the taller box and reuse the row structure that is actually proven,
     giving the extra height to a genuinely new section (the week strip)
     instead of asking one column to hold more text than it was shown to
     render reliably.

     Selected at runtime, not by a separate provider: see
     BaseLekhWidgetProvider.expandedLayoutRes and onAppWidgetOptionsChanged.

     No plain <View>: RemoteViews cannot inflate android.view.View, and a
     layout containing one fails as "Problem loading widget". The dividers are
     ImageViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:layout_marginEnd="10dp"
            android:textColor="@color/widget_day"
            android:text="२९" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:text="श्रावण २०८३" />

            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="शुक्रबार" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:background="@color/widget_border" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/widget_ad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="14 Aug 2026" />

            <TextView
                android:id="@+id/widget_tithi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="प्रतिपदा" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="end"
                android:textColor="@color/widget_accent"
                android:text="गुँलाधर्म आरम्भ" />

            <TextView
                android:id="@+id/widget_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="end"
                android:layout_marginTop="2dp"
                android:textColor="@color/widget_muted"
                android:text="आगामी · हरितालिका तीज · ५ दिनमा" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_week_c0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="आइत" />
            <TextView android:id="@+id/widget_week_d0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२४" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="सोम" />
            <TextView android:id="@+id/widget_week_d1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२५" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="मङ्गल" />
            <TextView android:id="@+id/widget_week_d2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२६" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="बुध" />
            <TextView android:id="@+id/widget_week_d3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२७" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="बिहि" />
            <TextView android:id="@+id/widget_week_d4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२८" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c5"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="शुक्र" />
            <TextView android:id="@+id/widget_week_d5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="२९" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c6"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_week_label"
                android:text="शनि" />
            <TextView android:id="@+id/widget_week_d6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_week_day" android:text="३०" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
