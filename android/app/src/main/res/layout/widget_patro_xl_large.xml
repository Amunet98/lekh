<?xml version="1.0" encoding="utf-8"?>
<!-- 5x2. The most detailed size: everything the 4x2 shows, plus the upcoming
     festival, plus a strip of the current week with today marked.

     The week strip is the reason this size exists. It is the one thing none of
     the smaller shapes can do — seven columns need real width — and it is what
     turns the widget from "what is the date" into "where am I in the week",
     which is the question a wall patro actually answers.

     Every cell in the strip is a fixed pair of ids (widget_week_l0..6 for the
     weekday letters, widget_week_d0..6 for the dates, widget_week_c0..6 for
     the containers the today-marker is applied to). The letters are static and
     live in this file; only the dates, colours and the marker are set at draw
     time.

     No plain <View>: RemoteViews cannot inflate android.view.View, and a
     layout containing one fails as "Problem loading widget". The dividers are
     ImageViews. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="14dp">

            <TextView
                android:id="@+id/widget_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/widget_text"
                android:text="२९" />

            <TextView
                android:id="@+id/widget_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:text="श्रावण २०८३" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="4dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@null"
            android:background="@color/widget_border" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_weekday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:text="शुक्रबार" />

            <TextView
                android:id="@+id/widget_ad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="14 Aug 2026" />

            <TextView
                android:id="@+id/widget_tithi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:text="प्रतिपदा" />

            <TextView
                android:id="@+id/widget_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                android:textColor="@color/widget_accent"
                android:text="गुँलाधर्म आरम्भ" />

            <TextView
                android:id="@+id/widget_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/widget_muted"
                android:text="आगामी · हरितालिका तीज · ५ दिनमा" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:contentDescription="@null"
        android:background="@color/widget_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/widget_week_c0"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="आइत" />
            <TextView android:id="@+id/widget_week_d0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२४" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c1"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="सोम" />
            <TextView android:id="@+id/widget_week_d1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२५" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c2"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="मङ्गल" />
            <TextView android:id="@+id/widget_week_d2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२६" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c3"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="बुध" />
            <TextView android:id="@+id/widget_week_d3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२७" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c4"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="बिहि" />
            <TextView android:id="@+id/widget_week_d4"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२८" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c5"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="शुक्र" />
            <TextView android:id="@+id/widget_week_d5"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="२९" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_week_c6"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center"
            android:paddingVertical="3dp">
            <TextView android:id="@+id/widget_week_l6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="9sp" android:textColor="@color/widget_muted"
                android:text="शनि" />
            <TextView android:id="@+id/widget_week_d6"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:includeFontPadding="false"
                android:textColor="@color/widget_text" android:text="३०" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
