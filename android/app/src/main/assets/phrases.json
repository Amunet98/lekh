[{"en":"Hello / Goodbye","ne":"नमस्ते","say":"Namaste"},{"en":"Thank you","ne":"धन्यवाद","say":"Dhanyabad"},{"en":"How are you?","ne":"तपाईंलाई कस्तो छ?","say":"Tapainlai kasto chha?"},{"en":"I’m fine","ne":"म ठिक छु।","say":"Ma thik chhu."},{"en":"What is your name?","ne":"तपाईंको नाम के हो?","say":"Tapainko nam ke ho?"},{"en":"Yes","ne":"हो","say":"Ho"},{"en":"No","ne":"होइन","say":"Hoina"},{"en":"Excuse me / Sorry","ne":"माफ गर्नुहोस्।","say":"Maaf garnuhos."},{"en":"I don’t understand","ne":"मैले बुझिनँ।","say":"Maile bujhinan."},{"en":"Do you speak English?","ne":"तपाईं अंग्रेजी बोल्नुहुन्छ?","say":"Tapain angreji bolnuhunchha?"},{"en":"Please speak slowly","ne":"बिस्तारै बोल्नुहोस्।","say":"Bistarai bolnuhos."},{"en":"Please charge by the meter","ne":"मिटर अनुसार लिनुहोस्।","say":"Meter anusar linuhos."},{"en":"Stop here, please","ne":"यहीँ रोक्नुहोस्।","say":"Yahin roknuhos."},{"en":"Left","ne":"देब्रे","say":"Debre"},{"en":"Right","ne":"दाहिने","say":"Dahine"},{"en":"Straight on","ne":"सिधा","say":"Sidha"},{"en":"How far is it?","ne":"कति टाढा छ?","say":"Kati tadha chha?"},{"en":"How much is this?","ne":"यो कति हो?","say":"Yo kati ho?"},{"en":"That’s too expensive","ne":"धेरै महँगो भयो।","say":"Dherai mahango bhayo."},{"en":"Can you make it cheaper?","ne":"अलि सस्तो गर्नुहोस् न।","say":"Ali sasto garnuhos na."},{"en":"I’ll take it","ne":"म यो लिन्छु।","say":"Ma yo linchhu."},{"en":"Do you take cards?","ne":"कार्ड चल्छ?","say":"Card chalchha?"},{"en":"Where is an ATM?","ne":"एटिएम कहाँ छ?","say":"ATM kahan chha?"},{"en":"Water, please","ne":"पानी दिनुहोस्।","say":"Pani dinuhos."},{"en":"Not spicy, please","ne":"पिरो नहाल्नुहोस्।","say":"Piro nahalnuhos."},{"en":"I’m vegetarian","ne":"म शाकाहारी हुँ।","say":"Ma shakahari hun."},{"en":"It’s delicious!","ne":"मीठो छ!","say":"Mitho chha!"},{"en":"The bill, please","ne":"बिल ल्याउनुहोस्।","say":"Bil lyaunuhos."},{"en":"Is this water safe to drink?","ne":"यो पानी पिउन हुन्छ?","say":"Yo pani piun hunchha?"},{"en":"Do you have a room?","ne":"कोठा पाइन्छ?","say":"Kotha painchha?"},{"en":"How much for one night?","ne":"एक रातको कति हो?","say":"Ek ratko kati ho?"},{"en":"Where is the toilet?","ne":"ट्वाइलेट कहाँ छ?","say":"Toilet kahan chha?"},{"en":"Is there Wi-Fi?","ne":"वाइफाइ छ?","say":"Wi-Fi chha?"},{"en":"Help!","ne":"बचाउनुहोस्!","say":"Bachaunuhos!"},{"en":"I need a doctor","ne":"मलाई डाक्टर चाहियो।","say":"Malai doctor chahiyo."},{"en":"Please call the police","ne":"प्रहरी बोलाउनुहोस्।","say":"Prahari bolaunuhos."},{"en":"Please take me to a hospital","ne":"मलाई अस्पताल लैजानुहोस्।","say":"Malai aspatal laijanuhos."},{"en":"I’m not feeling well","ne":"मलाई सन्चो छैन।","say":"Malai sancho chhaina."},{"en":"I have altitude sickness","ne":"मलाई लेक लाग्यो।","say":"Malai lek lagyo."},{"en":"I’m lost","ne":"म बाटो बिराएँ।","say":"Ma bato biraen."},{"en":"I lost my bag","ne":"मेरो झोला हरायो।","say":"Mero jhola harayo."}]